{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Monitors all TypeScript source files, configuration files, and schemas in the repository. When changes are detected, triggers documentation updates in README files and the docs folder to keep documentation in sync with code changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "backend/src/**/*.ts",
      "frontend/app/**/*.tsx",
      "frontend/app/**/*.ts",
      "frontend/components/**/*.tsx",
      "frontend/lib/**/*.ts",
      "backend/drizzle.config.ts",
      "frontend/next.config.ts",
      "backend/package.json",
      "frontend/package.json",
      "backend/src/db/schema.ts",
      "*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Source code files have been modified. Review the changes and update the relevant documentation:\n\n1. Analyze what changed in the source files\n2. Determine which documentation needs updating:\n   - README.md files (root, backend, frontend)\n   - backend/docs/ folder\n   - backend/API_DOCUMENTATION.md\n   - Any other relevant documentation files\n3. Update the documentation to reflect:\n   - New features or components\n   - Changed APIs or interfaces\n   - Updated configuration\n   - Modified data schemas\n   - New dependencies or setup steps\n4. Ensure documentation remains accurate, clear, and helpful for developers\n\nFocus on keeping documentation synchronized with the actual implementation."
  }
}